# Copie para .env.local e preencha. NUNCA suba o .env.local para o GitHub.
# Criada sozinha pela integração Neon na Vercel (local: postgres://usuario:senha@localhost:5432/baile)
DATABASE_URL=
# Senha do painel /dj (use uma frase longa, ex.: 4 palavras aleatórias)
DJ_PASSWORD=
# Texto aleatório longo. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=
# URL pública final do site (usada no QR code e no cartaz)
NEXT_PUBLIC_SITE_URL=https://seu-projeto.vercel.app
